---
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE } from '../data/site'
---

<BaseLayout
  title="Página no encontrada · LaNik"
  description="Esta página no existe. Explorá la colección de gorras y artesanías LaNik."
>

<section class="notfound">
  <div class="notfound-inner">
    <span class="notfound-code">404</span>
    <h1 class="notfound-title">Esta página<br>no existe.</h1>
    <p class="notfound-desc">
      Puede que el link esté roto o que la página haya sido movida.<br>
      Explorá la colección desde el inicio.
    </p>
    <div class="notfound-actions">
      <a href="/" class="btn-primary">Ir al inicio →</a>
      <a href="/gorras" class="btn-secondary">Ver gorras</a>
      <a href="/artesanias" class="btn-secondary">Ver artesanías</a>
    </div>
  </div>
</section>

<style>
  .notfound {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120px 5% 80px;
    background: var(--dark);
    text-align: center;
  }
  .notfound-inner { max-width: 560px; }
  .notfound-code {
    font-family: var(--font-head);
    font-size: 7rem;
    font-weight: 700;
    color: rgba(181,67,42,0.15);
    line-height: 1;
    display: block;
    letter-spacing: -4px;
    margin-bottom: 8px;
  }
  .notfound-title {
    font-family: var(--font-head);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--white);
    letter-spacing: -1px;
    line-height: 1.1;
    margin-bottom: 20px;
  }
  .notfound-desc {
    font-size: 0.95rem;
    color: rgba(255,255,255,0.45);
    line-height: 1.7;
    margin-bottom: 40px;
  }
  .notfound-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn-primary {
    display: inline-block;
    background: var(--terracota);
    color: var(--white);
    font-family: var(--font-head);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 12px 24px;
    border-radius: 40px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .btn-primary:hover { background: var(--terracota-light); }
  .btn-secondary {
    display: inline-block;
    background: transparent;
    color: rgba(255,255,255,0.6);
    font-family: var(--font-head);
    font-size: 0.9rem;
    font-weight: 500;
    padding: 12px 24px;
    border-radius: 40px;
    border: 1px solid rgba(255,255,255,0.15);
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }
  .btn-secondary:hover {
    color: var(--white);
    border-color: rgba(255,255,255,0.35);
  }
</style>

</BaseLayout>
