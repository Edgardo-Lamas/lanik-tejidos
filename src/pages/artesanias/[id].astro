---
export const prerender = true
import BaseLayout from '../../layouts/BaseLayout.astro'
import { artesanias } from '../../data/artesanias'
import { SITE } from '../../data/site'

export function getStaticPaths() {
  return artesanias.map(a => ({ params: { id: a.id }, props: { artesania: a } }))
}

const { artesania } = Astro.props

const badgeColor: Record<string, string> = {
  'Serie Limitada':   'badge--limited',
  'Últimas unidades': 'badge--last',
  'Agotado':          'badge--out',
  'Disponible':       'badge--available',
  'Encargo':          'badge--encargo',
}

const related = artesanias
  .filter(a => a.id !== artesania.id && a.categoria === artesania.categoria && a.disponible)
  .slice(0, 3)

const waUrl = `https://wa.me/${SITE.wa}?text=${encodeURIComponent(artesania.waMessage)}`
---
export const prerender = true

<BaseLayout
  title={`${artesania.nombre} — LaNik Diseño & Tejido`}
  description={`${artesania.descripcion} Tejido a mano en Buenos Aires.`}
  ogImage={artesania.fotos[0]}
>

  <!-- BREADCRUMB -->
  <nav class="breadcrumb" aria-label="Navegación de migas de pan">
    <div class="breadcrumb-inner">
      <a href="/artesanias" class="back-nav">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Artesanías
      </a>
      <span class="bc-sep" aria-hidden="true">›</span>
      <a href={`/artesanias`} class="bc-link">{artesania.categoria}</a>
      <span class="bc-sep" aria-hidden="true">›</span>
      <span>{artesania.nombre}</span>
    </div>
  </nav>

  <!-- DETALLE PRINCIPAL -->
  <section class="product-detail">
    <div class="product-detail-inner">

      <!-- GALERÍA -->
      <div class="gallery">
        <div class="gallery-main">
          <img
            id="gallery-main-img"
            src={artesania.fotos[0]}
            alt={`LaNik — ${artesania.nombre}`}
          />
          {!artesania.disponible && (
            <div class="gallery-out-overlay">
              <span>Agotado</span>
            </div>
          )}
        </div>
        {artesania.fotos.length > 1 && (
          <div class="gallery-thumbs">
            {artesania.fotos.map((foto, i) => (
              <button
                class:list={['thumb-btn', { 'thumb-btn--active': i === 0 }]}
                data-src={foto}
                aria-label={`Ver foto ${i + 1}`}
              >
                <img src={foto} alt="" loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- INFO -->
      <div class="product-info">

        <div class="product-info-top">
          <span class:list={['product-badge', badgeColor[artesania.badge] ?? '']}>{artesania.badge}</span>
          <span class="product-cat-tag">{artesania.categoria}</span>
        </div>

        <h1 class="product-name">{artesania.nombre}</h1>

        <div class="product-price-row">
          {artesania.precio
            ? <span class="product-price">${artesania.precio.toLocaleString('es-AR')}</span>
            : <span class="product-price product-price--consultar">Precio a consultar</span>
          }
          <span class="product-price-note">Tejido a mano · Pieza única</span>
        </div>

        <p class="product-desc">{artesania.descripcion}</p>

        <div class="product-features">
          <div class="feature-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>100% artesanal, tejido a mano</span>
          </div>
          <div class="feature-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12V22H4V12"/><path d="M22 7H2v5h20V7z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
            <span>Envío a todo el país</span>
          </div>
          {artesania.badge === 'Encargo' && (
            <div class="feature-item feature-item--highlight">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              <span>Esta pieza se hace por encargo — consultá disponibilidad y colores</span>
            </div>
          )}
        </div>

        {artesania.disponible ? (
          <a
            href={waUrl}
            target="_blank"
            rel="noopener"
            class="cta-whatsapp"
            data-track="click_whatsapp_artesania"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            {artesania.badge === 'Encargo' ? 'Consultar encargo por WhatsApp' : 'Consultar por WhatsApp'}
          </a>
        ) : (
          <div class="cta-out">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
            Pieza agotada
          </div>
        )}

        <a href="/artesanias" class="back-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          Ver todas las artesanías
        </a>

      </div>
    </div>
  </section>

  <!-- RELACIONADOS -->
  {related.length > 0 && (
    <section class="related-section">
      <div class="related-inner">
        <div class="related-header">
          <span class="section-tag">Más {artesania.categoria}</span>
          <h2 class="related-title">También te puede interesar</h2>
        </div>
        <div class="related-grid">
          {related.map(r => (
            <a href={`/artesanias/${r.id}`} class="related-card">
              <div class="related-card-img">
                <img src={r.fotoHero} alt={`LaNik — ${r.nombre}`} loading="lazy" />
                <div class="related-card-overlay"></div>
                <span class:list={['product-badge product-badge--sm', badgeColor[r.badge] ?? '']}>{r.badge}</span>
              </div>
              <div class="related-card-body">
                <h3 class="related-card-name">{r.nombre}</h3>
                <div class="related-card-footer">
                  <span class="related-card-price">
                    {r.precio ? `$${r.precio.toLocaleString('es-AR')}` : 'Consultar'}
                  </span>
                  <span class="related-card-cta">Ver pieza →</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<script>
  const mainImg = document.getElementById('gallery-main-img') as HTMLImageElement | null
  const thumbBtns = document.querySelectorAll<HTMLButtonElement>('.thumb-btn')

  thumbBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const src = btn.dataset.src
      if (!src || !mainImg) return
      mainImg.style.opacity = '0'
      setTimeout(() => {
        mainImg.src = src
        mainImg.style.opacity = '1'
      }, 150)
      thumbBtns.forEach(b => b.classList.remove('thumb-btn--active'))
      btn.classList.add('thumb-btn--active')
    })
  })
</script>

<style>
/* BREADCRUMB */
.breadcrumb {
  background: var(--charcoal);
  border-bottom: 1px solid rgba(255,255,255,0.06);
  padding: 100px 5% 16px;
}
.breadcrumb-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-head);
  font-size: 0.75rem;
  font-weight: 500;
}
.back-nav {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: rgba(255,255,255,0.75);
  text-decoration: none;
  font-weight: 600;
  font-size: 0.8rem;
  padding: 6px 12px 6px 8px;
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 8px;
  background: rgba(255,255,255,0.05);
  transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.15s;
}
.back-nav:hover {
  background: rgba(255,255,255,0.1);
  border-color: rgba(255,255,255,0.25);
  color: var(--white);
  transform: translateX(-2px);
}
.bc-link {
  color: rgba(255,255,255,0.38);
  text-decoration: none;
  transition: color 0.2s;
}
.bc-link:hover { color: var(--white); }
.breadcrumb-inner span:last-child { color: rgba(255,255,255,0.7); }
.bc-sep { color: rgba(255,255,255,0.2); }

/* DETALLE */
.product-detail { background: var(--charcoal); padding: 48px 5% 80px; }
.product-detail-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: start;
}

/* GALERÍA */
.gallery { position: sticky; top: 100px; }
.gallery-main {
  position: relative;
  aspect-ratio: 4/5;
  border-radius: 20px;
  overflow: hidden;
  background: var(--charcoal-mid);
}
.gallery-main img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 0.15s ease;
}
.gallery-out-overlay {
  position: absolute;
  inset: 0;
  background: rgba(26,26,26,0.65);
  display: flex;
  align-items: center;
  justify-content: center;
}
.gallery-out-overlay span {
  font-family: var(--font-head);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.5);
  border: 1px solid rgba(255,255,255,0.2);
  padding: 8px 20px;
  border-radius: 6px;
}
.gallery-thumbs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  margin-top: 12px;
}
.thumb-btn {
  all: unset;
  cursor: pointer;
  border-radius: 10px;
  overflow: hidden;
  aspect-ratio: 1;
  border: 2px solid transparent;
  transition: border-color 0.2s;
}
.thumb-btn img { width: 100%; height: 100%; object-fit: cover; display: block; filter: brightness(0.75); transition: filter 0.2s; }
.thumb-btn--active { border-color: var(--terracota); }
.thumb-btn--active img, .thumb-btn:hover img { filter: brightness(1); }

/* INFO */
.product-info { padding-top: 8px; }
.product-info-top {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
}
.product-cat-tag {
  font-family: var(--font-head);
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--terracota);
}
.product-badge {
  font-family: var(--font-head);
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 6px;
}
.product-badge--sm { font-size: 0.55rem; padding: 3px 8px; }
.badge--available  { background: rgba(26,26,26,0.75); color: rgba(255,255,255,0.6); border: 1px solid rgba(255,255,255,0.12); }
.badge--limited    { background: var(--terracota); color: var(--white); }
.badge--last       { background: var(--ocre); color: var(--white); }
.badge--out        { background: rgba(255,255,255,0.12); color: rgba(255,255,255,0.45); }
.badge--encargo    { background: var(--sage); color: var(--charcoal); }

.product-name {
  font-family: var(--font-head);
  font-size: clamp(2rem, 4vw, 3.2rem);
  font-weight: 700;
  color: var(--white);
  letter-spacing: -1.5px;
  line-height: 1;
  margin-bottom: 20px;
}
.product-price-row {
  display: flex;
  align-items: baseline;
  gap: 14px;
  margin-bottom: 24px;
  padding-bottom: 24px;
  border-bottom: 1px solid rgba(255,255,255,0.07);
}
.product-price {
  font-family: var(--font-head);
  font-size: 2rem;
  font-weight: 700;
  color: var(--crema);
  letter-spacing: -1px;
}
.product-price--consultar {
  font-size: 1.3rem;
  color: rgba(255,255,255,0.45);
}
.product-price-note { font-size: 0.78rem; color: rgba(255,255,255,0.3); font-weight: 300; }
.product-desc {
  font-size: 1rem;
  color: rgba(255,255,255,0.6);
  font-weight: 300;
  line-height: 1.8;
  margin-bottom: 32px;
}
.product-features {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 36px;
  padding: 24px;
  background: rgba(255,255,255,0.04);
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,0.06);
}
.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  font-family: var(--font-head);
  font-size: 0.82rem;
  font-weight: 500;
  color: rgba(255,255,255,0.55);
}
.feature-item svg { color: var(--terracota); flex-shrink: 0; margin-top: 1px; }
.feature-item--highlight { color: rgba(255,255,255,0.75); }
.feature-item--highlight svg { color: var(--sage); }

.cta-whatsapp {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  padding: 18px 32px;
  background: #25D366;
  color: #fff;
  font-family: var(--font-head);
  font-size: 0.95rem;
  font-weight: 700;
  border-radius: 14px;
  text-decoration: none;
  transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
  margin-bottom: 20px;
}
.cta-whatsapp:hover {
  background: #20be5c;
  transform: translateY(-2px);
  box-shadow: 0 12px 32px rgba(37,211,102,0.3);
}
.cta-out {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  padding: 18px 32px;
  background: rgba(255,255,255,0.05);
  color: rgba(255,255,255,0.3);
  font-family: var(--font-head);
  font-size: 0.95rem;
  font-weight: 600;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,0.08);
  margin-bottom: 20px;
  cursor: not-allowed;
}
.back-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-head);
  font-size: 0.78rem;
  font-weight: 500;
  color: rgba(255,255,255,0.35);
  text-decoration: none;
  transition: color 0.2s;
}
.back-link:hover { color: rgba(255,255,255,0.7); }

/* RELACIONADOS */
.related-section {
  background: var(--charcoal-mid);
  border-top: 1px solid rgba(255,255,255,0.06);
  padding: 64px 5% 100px;
}
.related-inner { max-width: 1200px; margin: 0 auto; }
.related-header { margin-bottom: 40px; }
.related-title {
  font-family: var(--font-head);
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 700;
  color: var(--white);
  letter-spacing: -1.5px;
  line-height: 1;
  margin-top: 10px;
}
.related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.related-card {
  display: block;
  text-decoration: none;
  border-radius: 16px;
  overflow: hidden;
  background: var(--charcoal);
  border: 1px solid rgba(255,255,255,0.08);
  transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
}
.related-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 20px 50px rgba(0,0,0,0.45);
  border-color: rgba(181,67,42,0.4);
}
.related-card-img { position: relative; aspect-ratio: 4/5; overflow: hidden; }
.related-card-img img {
  width: 100%; height: 100%; object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.25,0.46,0.45,0.94);
  filter: brightness(0.9) contrast(1.05);
}
.related-card:hover .related-card-img img { transform: scale(1.05); }
.related-card-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(26,26,26,0.6) 0%, transparent 50%);
}
.related-card-body { padding: 18px 20px 22px; }
.related-card-name {
  font-family: var(--font-head);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--white);
  letter-spacing: -0.5px;
  margin-bottom: 14px;
}
.related-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12px;
  border-top: 1px solid rgba(255,255,255,0.07);
}
.related-card-price {
  font-family: var(--font-head);
  font-size: 1rem;
  font-weight: 700;
  color: var(--crema);
  letter-spacing: -0.5px;
}
.related-card-cta {
  font-family: var(--font-head);
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--terracota);
  transition: letter-spacing 0.2s;
}
.related-card:hover .related-card-cta { letter-spacing: 0.5px; }

/* RESPONSIVE */
@media (max-width: 1000px) {
  .product-detail-inner { grid-template-columns: 1fr; gap: 36px; }
  .gallery { position: static; }
  .gallery-main { aspect-ratio: 3/2; }
  .related-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .breadcrumb { padding: 90px 5% 14px; }
  .product-detail { padding: 32px 5% 60px; }
  .related-grid { grid-template-columns: 1fr; }
  .product-price-row { flex-wrap: wrap; gap: 6px; }
}
</style>
