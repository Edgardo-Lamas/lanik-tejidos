---
export const prerender = true
import BaseLayout from '../../layouts/BaseLayout.astro'
import { gorras } from '../../data/gorras'
import { SITE } from '../../data/site'

export function getStaticPaths() {
  return gorras.map(g => ({ params: { id: g.id }, props: { gorra: g } }))
}

const { gorra } = Astro.props

const badgeColor: Record<string, string> = {
  'Serie Limitada':   'badge--limited',
  'Últimas unidades': 'badge--last',
  'Agotado':          'badge--out',
  'Disponible':       'badge--available',
}

const related = gorras.filter(g => g.id !== gorra.id && g.disponible).slice(0, 3)

const waUrl = `https://wa.me/${SITE.wa}?text=${encodeURIComponent(gorra.waMessage)}`
---
export const prerender = true

<BaseLayout
  title={`${gorra.nombre} — LaNik Diseño & Tejido`}
  description={`${gorra.descripcion} Tejida a mano en Buenos Aires. ${gorra.colores.join(', ')}.`}
>

  <!-- BREADCRUMB -->
  <nav class="breadcrumb" aria-label="Navegación de migas de pan">
    <div class="breadcrumb-inner">
      <a href="/gorras" class="back-nav">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Gorras
      </a>
      <span class="bc-sep" aria-hidden="true">›</span>
      <span>{gorra.nombre}</span>
    </div>
  </nav>

  <!-- DETALLE PRINCIPAL -->
  <section class="product-detail">
    <div class="product-detail-inner">

      <!-- GALERÍA -->
      <div class="gallery">
        <div class="gallery-main">
          <img
            id="gallery-main-img"
            src={gorra.fotos[0]}
            alt={`LaNik — ${gorra.nombre}`}
          />
          {!gorra.disponible && (
            <div class="gallery-out-overlay">
              <span>Agotado</span>
            </div>
          )}
        </div>
        {gorra.fotos.length > 1 && (
          <div class="gallery-thumbs">
            {gorra.fotos.map((foto, i) => (
              <button
                class:list={['thumb-btn', { 'thumb-btn--active': i === 0 }]}
                data-src={foto}
                data-index={i}
                aria-label={`Ver foto ${i + 1} de ${gorra.nombre}`}
              >
                <img src={foto} alt="" loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- INFO -->
      <div class="product-info">

        <div class="product-info-top">
          <span class:list={['product-badge', badgeColor[gorra.badge] ?? '']}>{gorra.badge}</span>
          <div class="product-colors-tag">{gorra.colores.join(' · ')}</div>
        </div>

        <h1 class="product-name">{gorra.nombre}</h1>

        <div class="product-price-row">
          {gorra.disponible
            ? <span class="product-price">${gorra.precio.toLocaleString('es-AR')}</span>
            : <span class="product-price product-price--out">Agotado</span>
          }
          <span class="product-price-note">Tejido a mano · Unidad única</span>
        </div>

        <p class="product-desc">{gorra.descripcion}</p>

        <div class="product-features">
          <div class="feature-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>100% artesanal, tejido a mano</span>
          </div>
          <div class="feature-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12V22H4V12"/><path d="M22 7H2v5h20V7z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
            <span>Envío a todo el país</span>
          </div>
          <div class="feature-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Respondemos en menos de 24 hs</span>
          </div>
        </div>

        {gorra.disponible ? (
          <a
            href={waUrl}
            target="_blank"
            rel="noopener"
            class="cta-whatsapp"
            data-track="click_whatsapp_product"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Consultar por WhatsApp
          </a>
        ) : (
          <div class="cta-out">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
            Modelo agotado
          </div>
        )}

        <a href="/gorras" class="back-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          Ver toda la colección
        </a>

      </div>
    </div>
  </section>

  <!-- CUIDADOS -->
  <section class="care-section">
    <div class="care-inner">
      <h2 class="care-title">Cuidados del tejido</h2>
      <div class="care-grid">
        <div class="care-item">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0"/><path d="M12 8v4l3 3"/></svg>
          <div>
            <strong>Lavado a mano</strong>
            <span>Agua fría o tibia, sin frotar</span>
          </div>
        </div>
        <div class="care-item">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>
          <div>
            <strong>Secado plano</strong>
            <span>No colgar para mantener la forma</span>
          </div>
        </div>
        <div class="care-item">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
          <div>
            <strong>Sin centrifugado</strong>
            <span>No usar lavarropas ni secadora</span>
          </div>
        </div>
        <div class="care-item">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/><path d="M8 12l3 3 5-5"/></svg>
          <div>
            <strong>Guardar doblado</strong>
            <span>En lugar fresco y seco</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- RELACIONADOS -->
  {related.length > 0 && (
    <section class="related-section">
      <div class="related-inner">
        <div class="related-header">
          <span class="section-tag">También te puede interesar</span>
          <h2 class="related-title">Otros modelos</h2>
        </div>
        <div class="related-grid">
          {related.map(r => (
            <a href={`/gorras/${r.id}`} class="related-card">
              <div class="related-card-img">
                <img src={r.fotoHero} alt={`LaNik — ${r.nombre}`} loading="lazy" />
                <div class="related-card-overlay"></div>
                <span class:list={['product-badge product-badge--sm', badgeColor[r.badge] ?? '']}>{r.badge}</span>
              </div>
              <div class="related-card-body">
                <div class="related-card-colors">{r.colores.join(' · ')}</div>
                <h3 class="related-card-name">{r.nombre}</h3>
                <div class="related-card-footer">
                  <span class="related-card-price">${r.precio.toLocaleString('es-AR')}</span>
                  <span class="related-card-cta">Ver modelo →</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<script>
  const mainImg = document.getElementById('gallery-main-img') as HTMLImageElement | null
  const thumbBtns = document.querySelectorAll<HTMLButtonElement>('.thumb-btn')

  thumbBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const src = btn.dataset.src
      if (!src || !mainImg) return
      mainImg.classList.add('gallery-main-img--fade')
      setTimeout(() => {
        mainImg.src = src
        mainImg.classList.remove('gallery-main-img--fade')
      }, 160)
      thumbBtns.forEach(b => b.classList.remove('thumb-btn--active'))
      btn.classList.add('thumb-btn--active')
    })
  })
</script>

<style>
/* ─── BREADCRUMB ─── */
.breadcrumb {
  background: var(--charcoal);
  border-bottom: 1px solid rgba(255,255,255,0.06);
  padding: 100px 5% 16px;
}
.breadcrumb-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-head);
  font-size: 0.75rem;
  font-weight: 500;
}
.back-nav {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: rgba(255,255,255,0.75);
  text-decoration: none;
  font-weight: 600;
  font-size: 0.8rem;
  padding: 6px 12px 6px 8px;
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 8px;
  background: rgba(255,255,255,0.05);
  transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.15s;
}
.back-nav:hover {
  background: rgba(255,255,255,0.1);
  border-color: rgba(255,255,255,0.25);
  color: var(--white);
  transform: translateX(-2px);
}
.breadcrumb-inner span:last-child { color: rgba(255,255,255,0.7); }
.bc-sep { color: rgba(255,255,255,0.2); }

/* ─── DETALLE PRINCIPAL ─── */
.product-detail {
  background: var(--charcoal);
  padding: 48px 5% 80px;
}
.product-detail-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: start;
}

/* ─── GALERÍA ─── */
.gallery { position: sticky; top: 100px; }
.gallery-main {
  position: relative;
  aspect-ratio: 4/5;
  border-radius: 20px;
  overflow: hidden;
  background: var(--charcoal-mid);
}
.gallery-main img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 0.16s ease;
}
.gallery-main-img--fade { opacity: 0; }
.gallery-out-overlay {
  position: absolute;
  inset: 0;
  background: rgba(26,26,26,0.65);
  display: flex;
  align-items: center;
  justify-content: center;
}
.gallery-out-overlay span {
  font-family: var(--font-head);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.5);
  border: 1px solid rgba(255,255,255,0.2);
  padding: 8px 20px;
  border-radius: 6px;
}
.gallery-thumbs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  margin-top: 12px;
}
.thumb-btn {
  all: unset;
  cursor: pointer;
  border-radius: 10px;
  overflow: hidden;
  aspect-ratio: 1;
  border: 2px solid transparent;
  transition: border-color 0.2s, transform 0.2s;
}
.thumb-btn img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: brightness(0.75);
  transition: filter 0.2s;
}
.thumb-btn--active { border-color: var(--terracota); }
.thumb-btn--active img { filter: brightness(1); }
.thumb-btn:hover img { filter: brightness(0.95); }

/* ─── INFO ─── */
.product-info { padding-top: 8px; }
.product-info-top {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
}
.product-colors-tag {
  font-family: var(--font-head);
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--terracota);
}

/* BADGE */
.product-badge {
  font-family: var(--font-head);
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 6px;
}
.product-badge--sm { font-size: 0.55rem; padding: 3px 8px; }
.badge--available  { background: rgba(26,26,26,0.75); color: rgba(255,255,255,0.6); border: 1px solid rgba(255,255,255,0.12); }
.badge--limited    { background: var(--terracota);    color: var(--white); }
.badge--last       { background: var(--ocre);         color: var(--white); }
.badge--out        { background: rgba(255,255,255,0.12); color: rgba(255,255,255,0.45); }

.product-name {
  font-family: var(--font-head);
  font-size: clamp(2rem, 4vw, 3.2rem);
  font-weight: 700;
  color: var(--white);
  letter-spacing: -1.5px;
  line-height: 1;
  margin-bottom: 20px;
}
.product-price-row {
  display: flex;
  align-items: baseline;
  gap: 14px;
  margin-bottom: 24px;
  padding-bottom: 24px;
  border-bottom: 1px solid rgba(255,255,255,0.07);
}
.product-price {
  font-family: var(--font-head);
  font-size: 2rem;
  font-weight: 700;
  color: var(--crema);
  letter-spacing: -1px;
}
.product-price--out {
  color: rgba(255,255,255,0.35);
  font-size: 1.4rem;
}
.product-price-note {
  font-size: 0.78rem;
  color: rgba(255,255,255,0.3);
  font-weight: 300;
}
.product-desc {
  font-size: 1rem;
  color: rgba(255,255,255,0.6);
  font-weight: 300;
  line-height: 1.8;
  margin-bottom: 32px;
}
.product-features {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 36px;
  padding: 24px;
  background: rgba(255,255,255,0.04);
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,0.06);
}
.feature-item {
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: var(--font-head);
  font-size: 0.82rem;
  font-weight: 500;
  color: rgba(255,255,255,0.55);
}
.feature-item svg { color: var(--terracota); flex-shrink: 0; }

/* CTA */
.cta-whatsapp {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  padding: 18px 32px;
  background: #25D366;
  color: #fff;
  font-family: var(--font-head);
  font-size: 0.95rem;
  font-weight: 700;
  letter-spacing: 0.3px;
  border-radius: 14px;
  text-decoration: none;
  transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
  margin-bottom: 20px;
}
.cta-whatsapp:hover {
  background: #20be5c;
  transform: translateY(-2px);
  box-shadow: 0 12px 32px rgba(37,211,102,0.3);
}
.cta-out {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  padding: 18px 32px;
  background: rgba(255,255,255,0.05);
  color: rgba(255,255,255,0.3);
  font-family: var(--font-head);
  font-size: 0.95rem;
  font-weight: 600;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,0.08);
  margin-bottom: 20px;
  cursor: not-allowed;
}
.back-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-head);
  font-size: 0.78rem;
  font-weight: 500;
  color: rgba(255,255,255,0.35);
  text-decoration: none;
  transition: color 0.2s;
}
.back-link:hover { color: rgba(255,255,255,0.7); }

/* ─── CUIDADOS ─── */
.care-section {
  background: var(--charcoal-mid);
  border-top: 1px solid rgba(255,255,255,0.06);
  padding: 64px 5%;
}
.care-inner { max-width: 1200px; margin: 0 auto; }
.care-title {
  font-family: var(--font-head);
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--white);
  letter-spacing: -0.5px;
  margin-bottom: 32px;
}
.care-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
.care-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 20px;
  background: rgba(255,255,255,0.04);
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,0.06);
}
.care-item svg { color: var(--terracota); flex-shrink: 0; margin-top: 2px; }
.care-item div { display: flex; flex-direction: column; gap: 4px; }
.care-item strong {
  font-family: var(--font-head);
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--white);
}
.care-item span {
  font-size: 0.75rem;
  color: rgba(255,255,255,0.38);
  font-weight: 300;
  line-height: 1.5;
}

/* ─── RELACIONADOS ─── */
.related-section {
  background: var(--charcoal);
  border-top: 1px solid rgba(255,255,255,0.06);
  padding: 64px 5% 100px;
}
.related-inner { max-width: 1200px; margin: 0 auto; }
.related-header { margin-bottom: 40px; }
.related-title {
  font-family: var(--font-head);
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 700;
  color: var(--white);
  letter-spacing: -1.5px;
  line-height: 1;
  margin-top: 10px;
}
.related-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.related-card {
  display: block;
  text-decoration: none;
  border-radius: 16px;
  overflow: hidden;
  background: var(--charcoal-mid);
  border: 1px solid rgba(255,255,255,0.08);
  transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
}
.related-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 20px 50px rgba(0,0,0,0.45);
  border-color: rgba(181,67,42,0.4);
}
.related-card-img {
  position: relative;
  aspect-ratio: 4/5;
  overflow: hidden;
}
.related-card-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.25,0.46,0.45,0.94);
  filter: brightness(0.9) contrast(1.05);
}
.related-card:hover .related-card-img img { transform: scale(1.05); }
.related-card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(26,26,26,0.6) 0%, transparent 50%);
}
.related-card-body { padding: 18px 20px 22px; }
.related-card-colors {
  font-family: var(--font-head);
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--terracota);
  margin-bottom: 5px;
}
.related-card-name {
  font-family: var(--font-head);
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--white);
  letter-spacing: -0.5px;
  margin-bottom: 14px;
}
.related-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12px;
  border-top: 1px solid rgba(255,255,255,0.07);
}
.related-card-price {
  font-family: var(--font-head);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--crema);
