  <!-- ─── CTA CONTACTO ─────────────────────────────────── -->
  <section class="cta-section">
    <span class="section-tag" style="display:block;text-align:center;color:rgba(245,239,224,0.7)">
      Tejida para vos
    </span>
    <h2 class="section-title light" style="text-align:center;margin:16px auto 20px;max-width:560px">
      Escribinos.<br>Te respondemos hoy.
    </h2>
    <p class="contact-desc">
      ¿Te quedó algún modelo en la cabeza? Consultá disponibilidad, pedí tu talle o encargá una pieza en el color que quieras.
    </p>
    <div class="contact-actions">
      <a href={`https://wa.me/${SITE.wa}?text=Hola%20LaNik!%20Me%20interesa%20conocer%20los%20modelos%20disponibles.`}
         class="btn-white" target="_blank" data-track="click_whatsapp">
        <svg class="wa-icon" viewBox="0 0 24 24" fill="currentColor" style="width:20px;height:20px">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp
      </a>
      <a href={`https://instagram.com/${SITE.instagram}`} class="btn-outline-white" target="_blank" data-track="click_instagram">
        @{SITE.instagram}
      </a>
    </div>
  </section>

<script>
  /* ── HERO TILT 3D ───────────────────────────────────── */
  const heroWrap  = document.getElementById('heroTilt')
  const heroInner = document.getElementById('heroInner')
  const heroShine = document.getElementById('heroShine')

  if (heroWrap && heroInner && heroShine) {
    const MAX_X  = 10    // grados máx inclinación vertical
    const MAX_Y  = 18    // grados máx inclinación horizontal
    let rafId    = 0
    let isLeaving = false

    heroWrap.addEventListener('mousemove', (e: MouseEvent) => {
      isLeaving = false
      cancelAnimationFrame(rafId)
      rafId = requestAnimationFrame(() => {
        const rect = heroWrap.getBoundingClientRect()
        const x = (e.clientX - rect.left) / rect.width   // 0–1
        const y = (e.clientY - rect.top)  / rect.height  // 0–1

        const rotY =  (x - 0.5) * MAX_Y * 2
        const rotX = -(y - 0.5) * MAX_X * 2

        // Sin transition en mousemove — respuesta instantánea al cursor
        heroInner.style.transition = 'none'
        heroInner.style.transform  = `rotateX(${rotX}deg) rotateY(${rotY}deg) scale3d(1.03,1.03,1.03)`

        // Brillo sigue al cursor
        heroShine.style.setProperty('--mx', `${x * 100}%`)
        heroShine.style.setProperty('--my', `${y * 100}%`)
      })
    })

    heroWrap.addEventListener('mouseleave', () => {
      isLeaving = true
      cancelAnimationFrame(rafId)
      // Spring suave de vuelta al reposo
      heroInner.style.transition = 'transform 0.8s cubic-bezier(0.23,1,0.32,1)'
      heroInner.style.transform  = 'rotateX(0deg) rotateY(0deg) scale3d(1,1,1)'
    })
  }
</script>

<script>
  const section = document.getElementById('palermo')
  const bg      = document.getElementById('palermoBg')
  const pairs   = Array.from(document.querySelectorAll<HTMLElement>('.card-pair'))
  const dots    = Array.from(document.querySelectorAll<HTMLElement>('.pager-dot'))

  if (section && bg && pairs.length > 0) {
    const N    = pairs.length   // 3
    const STEP = 1 / N          // 0.333 — cada par ocupa 1/3 del scroll total
    const FADE = STEP * 0.22    // zona de crossfade = 22% de cada segmento

    function getOpacity(p: number, i: number): number {
      const s = i * STEP        // start del segmento
      const e = s + STEP        // end del segmento

      // Fuera del rango → invisible
      if (p < s - FADE || p > e + FADE) return 0

      // Par 0: sin fade-in (arranca completamente visible)
      const fadeIn  = i === 0     ? 1 : Math.min(1, (p - s) / FADE)
      // Último par: sin fade-out (queda visible al llegar al fondo)
      const fadeOut = i === N - 1 ? 1 : Math.min(1, (e - p) / FADE)

      return Math.max(0, Math.min(fadeIn, fadeOut))
    }

    function update() {
      const rect       = section.getBoundingClientRect()
      const scrollable = section.offsetHeight - window.innerHeight
      const progress   = Math.max(0, Math.min(1, -rect.top / scrollable))

      // Parallax vertical + ligero paneo horizontal
      // Vertical: el fondo sube mientras scrolleás — sensación de avanzar
      const yPct = -progress * 40
      // Horizontal: suave movimiento diagonal para dar profundidad
      const xPct = (progress - 0.5) * 6
      bg.style.transform = `translate(${xPct}%, ${yPct}%)`

      // Rotar pares — cada uno aparece en su propia posición del viewport
      pairs.forEach((pair, i) => {
        const op = getOpacity(progress, i)
        pair.style.opacity       = String(op)
        // Entrada desde abajo, salida hacia arriba — movimiento natural
        const yOffset = i === 0 && progress < STEP
          ? (1 - op) * 32        // par 0 entra desde abajo
          : op < 0.99
            ? (progress > i * STEP + STEP / 2 ? -1 : 1) * (1 - op) * 32
            : 0
        pair.style.transform     = `translateY(${yOffset}px)`
        pair.style.pointerEvents = op > 0.3 ? 'auto' : 'none'
      })

      // Dots
      const active = Math.min(Math.floor(progress / STEP), N - 1)
      dots.forEach((d, i) => d.classList.toggle('active', i === active))
    }

    window.addEventListener('scroll', update, { passive: true })
    update()   // inicializar estado correcto al cargar
  }
</script>

<script>
  /* ── VIDEO LAZY LOAD ────────────────────────────── */
  const lazyVideo = document.querySelector<HTMLVideoElement>('video[data-src]')
  if (lazyVideo) {
    const videoObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const v = entry.target as HTMLVideoElement
          v.src = v.dataset.src!
          v.play().catch(() => {})
          videoObserver.unobserve(v)
        }
      })
    }, { rootMargin: '200px' })
    videoObserver.observe(lazyVideo)
  }

  /* ── SUBTITLE CHAR STAGGER ──────────────────────── */
  const sub = document.querySelector<HTMLElement>('.hero-subtitle')
  if (sub) {
    const BASE_DELAY = 0.65
    const STEP       = 0.032
    const text       = sub.textContent ?? ''
    sub.innerHTML    = ''
    sub.style.cssText += '; opacity:1; transform:none; animation:none'
    text.split('').forEach((char, i) => {
      const s = document.createElement('span')
      s.className = 'hero-char'
      s.textContent = char === ' ' ? ' ' : char
      s.style.animationDelay = `${BASE_DELAY + i * STEP}s`
      sub.appendChild(s)
    })
  }
</script>

</BaseLayout>

