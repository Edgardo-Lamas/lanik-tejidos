---
export const prerender = true
import BaseLayout from '../layouts/BaseLayout.astro'
import { categorias } from '../data/categorias'
import { gorras } from '../data/gorras'
import { SITE } from '../data/site'
---

<BaseLayout
  title="LaNik — Diseño & Tejido Artesanal Urbano"
  description="Gorras y artesanías tejidas 100% a mano en Buenos Aires. Series limitadas con identidad propia."
>

  <!-- ─── HERO ─────────────────────────────────────────── -->
  <section class="hero">

    <!-- Spotlight ported from Aceternity UI -->
    <svg class="hero-spotlight" viewBox="0 0 3787 2842" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <g filter="url(#hero-spotlight-filter)">
        <ellipse cx="1924.71" cy="273.501" rx="1924.71" ry="273.501"
          transform="matrix(-0.822377 -0.568943 -0.568943 0.822377 3631.88 2291.09)"
          fill="#B5432A" fill-opacity="0.18"/>
      </g>
      <defs>
        <filter id="hero-spotlight-filter" x="0.86" y="0.84" width="3785.16" height="2840.26"
          filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
          <feFlood flood-opacity="0" result="BackgroundImageFix"/>
          <feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
          <feGaussianBlur stdDeviation="120" result="effect1_foregroundBlur"/>
        </filter>
      </defs>
    </svg>

    <div class="hero-inner">
      <div class="hero-text">
        <span class="hero-badge hero-enter" style="--ed:0.1s">● Tejido Artesanal · Buenos Aires</span>
        <h1 class="hero-title">
          <span class="hero-tword hero-tword-la">La</span><span class="hero-tword hero-tword-nik">Nik</span>
        </h1>
        <p class="hero-subtitle">Diseño & Tejido Artesanal</p>
        <p class="hero-desc hero-enter" style="--ed:0.5s">
          Cada pieza tejida a mano, punto a punto. Series limitadas con identidad propia.
          Cuando se agota, no hay reposición.
        </p>
        <div class="hero-actions hero-enter" style="--ed:0.7s">
          <a href="/gorras" class="btn-primary">Ver colección →</a>
          <a href="/sobre-lanik" class="btn-secondary">Nuestra historia</a>
        </div>
        <div class="hero-stats hero-enter" style="--ed:0.9s">
          <div class="stat-item">
            <span class="stat-number">100%</span>
            <span class="stat-label">Tejido a mano</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">7+</span>
            <span class="stat-label">Modelos únicos</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">Ltda.</span>
            <span class="stat-label">Series limitadas</span>
          </div>
        </div>
      </div>
      <div class="hero-image hero-card-entry" id="heroTilt">
        <!-- wrapper float: solo maneja translateY -->
        <div class="hero-float">
          <!-- wrapper tilt: solo maneja rotateX/Y via JS -->
          <div class="hero-image-inner" id="heroInner">
            <img
              src="/fotos-lanik/hero-lifestyle.jpg"
              alt="LaNik — gorra tejida artesanal terracota, fotografía editorial de estudio"
              class="hero-img-main"
              fetchpriority="high"
              loading="eager"
            />
            <div class="hero-image-shine" id="heroShine"></div>
            <div class="hero-img-overlay">
              <div>
                <div class="hero-img-tag">Tejido a mano</div>
                <div class="hero-img-title">Terracota · Serie Otoño</div>
              </div>
              <div class="hero-badge-ltd">Serie Ltd.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="hero-scroll-hint" aria-hidden="true">
      <span class="scroll-hint-line"></span>
      <span class="scroll-hint-label">Scroll</span>
    </div>
  </section>

  <!-- ─── VIDEO SHOWCASE ──────────────────────────────── -->
  <section class="video-showcase">
    <div class="video-showcase-inner">
      <video
        class="showcase-video"
        data-src="/fotos-canva/video-hero.mp4"
        poster="/fotos-canva/video-poster.jpg"
        muted loop playsinline
        aria-hidden="true"
      ></video>
      <div class="showcase-overlay"></div>
      <div class="showcase-content reveal">
        <span class="section-tag" style="color:var(--crema)">El origen</span>
        <h2 class="showcase-title">Hilo por hilo,<br>todo a mano.</h2>
        <p class="showcase-desc">Nati elige cada hebra. Diseña el patrón. Lo teje punto a punto, sin prisa.<br>No hay dos gorras exactamente iguales.</p>
        <a href="/gorras" class="btn-primary">Ver la colección →</a>
      </div>
    </div>
  </section>

  <!-- ─── GALERÍA PALERMO SOHO ─────────────────────────── -->
  <section class="palermo-section" id="palermo">
    <div class="palermo-sticky">
      <div class="palermo-bg" id="palermoBg" style="background-image: url('/palermo-soho-v3.jpg')"></div>
      <div class="palermo-overlay"></div>

      <div class="palermo-ui">
        <div class="palermo-header">
          <span class="section-tag" style="color:var(--crema)">Colección</span>
          <h2 class="section-title light">Explorá nuestra<br>colección.</h2>
        </div>

        <!-- Par 1 -->
        <div class="card-pair" data-pair="0">
          {[gorras[1], gorras[5]].map(p => (
            <a href="/gorras" class="cat-card">
              <div class="cat-card-img">
                <img src={p.fotoHero} alt={`LaNik — ${p.nombre}`} loading="lazy" />
                <div class="cat-card-img-overlay"></div>
                <span class="cat-card-badge">{p.badge}</span>
              </div>
              <div class="cat-card-body">
                <div class="cat-card-tag">{p.colores.join(' · ')}</div>
                <h3 class="cat-card-title">{p.nombre}</h3>
                <p class="cat-card-desc">{p.descripcion}</p>
                <div class="cat-card-price">${p.precio.toLocaleString('es-AR')}</div>
                <span class="cat-card-cta">Ver modelo <span class="arrow">→</span></span>
              </div>
            </a>
          ))}
        </div>

        <!-- Par 2 -->
        <div class="card-pair" data-pair="1">
          {[gorras[2], gorras[4]].map(p => (
            <a href="/gorras" class="cat-card">
              <div class="cat-card-img">
                <img src={p.fotoHero} alt={`LaNik — ${p.nombre}`} loading="lazy" />
                <div class="cat-card-img-overlay"></div>
                <span class="cat-card-badge">{p.badge}</span>
              </div>
              <div class="cat-card-body">
                <div class="cat-card-tag">{p.colores.join(' · ')}</div>
                <h3 class="cat-card-title">{p.nombre}</h3>
                <p class="cat-card-desc">{p.descripcion}</p>
                <div class="cat-card-price">${p.precio.toLocaleString('es-AR')}</div>
                <span class="cat-card-cta">Ver modelo <span class="arrow">→</span></span>
              </div>
            </a>
          ))}
        </div>

        <!-- Par 3 -->
        <div class="card-pair" data-pair="2">
          {[gorras[0], gorras[6]].map(p => (
            <a href="/gorras" class="cat-card">
              <div class="cat-card-img">
                <img src={p.fotoHero} alt={`LaNik — ${p.nombre}`} loading="lazy" />
                <div class="cat-card-img-overlay"></div>
                <span class="cat-card-badge">{p.badge}</span>
              </div>
              <div class="cat-card-body">
                <div class="cat-card-tag">{p.colores.join(' · ')}</div>
                <h3 class="cat-card-title">{p.nombre}</h3>
                <p class="cat-card-desc">{p.descripcion}</p>
                <div class="cat-card-price">${p.precio.toLocaleString('es-AR')}</div>
                <span class="cat-card-cta">Ver modelo <span class="arrow">→</span></span>
              </div>
            </a>
          ))}
        </div>

        <!-- Indicador de scroll -->
        <div class="palermo-scroll-hint" id="palermoPager">
          <div class="pager-dot active"></div>
          <div class="pager-dot"></div>
          <div class="pager-dot"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── MODELS CAROUSEL ────────────────────────────────── -->
  <section class="models-section">
    <div class="models-header reveal">
      <span class="section-tag">Lo llevan así</span>
      <h2 class="section-title light">Diseñadas para<br>ser vividas.</h2>
    </div>
    <div class="models-track-wrap">
      <div class="models-track">
        {[
          { img: '1', nombre: 'Café Azul',        ciudad: 'Buenos Aires' },
          { img: '2', nombre: 'Paleta Otoño',      ciudad: 'Buenos Aires' },
          { img: '3', nombre: 'Terracota Ribbed',  ciudad: 'Buenos Aires' },
          { img: '4', nombre: 'Sage Geo',          ciudad: 'Buenos Aires' },
          { img: '5', nombre: 'Pompón Natural',    ciudad: 'Buenos Aires' },
          { img: '1', nombre: 'Café Azul',        ciudad: 'Buenos Aires' },
          { img: '2', nombre: 'Paleta Otoño',      ciudad: 'Buenos Aires' },
          { img: '3', nombre: 'Terracota Ribbed',  ciudad: 'Buenos Aires' },
          { img: '4', nombre: 'Sage Geo',          ciudad: 'Buenos Aires' },
          { img: '5', nombre: 'Pompón Natural',    ciudad: 'Buenos Aires' },
        ].map((m, i) => (
          <div class="model-item" aria-hidden={i >= 5 ? 'true' : undefined}>
            <img
              src={`/fotos-canva/model/gorra-model-${m.img}.webp`}
              alt={i < 5 ? `Modelo con gorra LaNik ${m.nombre}` : ''}
