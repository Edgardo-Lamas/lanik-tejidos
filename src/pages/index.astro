            />
            <div class="model-caption">
              <span class="model-caption-name">{m.nombre}</span>
              <span class="model-caption-city">{m.ciudad}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── PROCESO ──────────────────────────────────────── -->
  <section class="proceso-section">
    <div class="proceso-inner">
      <div class="proceso-header reveal">
        <span class="section-tag">El proceso</span>
        <h2 class="section-title light">Cada gorra,<br>hecha para durar.</h2>
      </div>
      <div class="proceso-grid">
        {[
          { num: '01', title: 'Selección del hilo',  desc: 'Hilos de lana y acrílico premium, seleccionados por textura, resistencia y color.' },
          { num: '02', title: 'Tejido a mano',        desc: 'Cada punto tejido uno a uno. Sin máquinas. Sin atajos. El tiempo es parte del valor.' },
          { num: '03', title: 'Control de calidad',   desc: 'Revisión de tensión, forma y acabados. Cada pieza aprobada antes de salir.' },
          { num: '04', title: 'Etiquetado y entrega', desc: 'Etiqueta de cuero grabada "LaNik diseño & tejido". Empaque cuidado. Envío a todo el país.' },
        ].map((step, i) => (
          <div class="proceso-step reveal" style={`transition-delay: ${i * 0.12}s`}>
            <div class="step-num">{step.num}</div>
            <div class="step-title">{step.title}</div>
            <div class="step-desc">{step.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── CREDENCIALES STRIP ───────────────────────────── -->
  <section class="creds-section reveal">
    <div class="creds-inner">
      <div class="cred-item">
        <svg class="cred-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="12 2 22 8.5 12 15 2 8.5 12 2"/>
          <path d="M6 11.8v4.7c2 1.8 8 1.8 12 0v-4.7"/>
          <line x1="22" y1="8.5" x2="22" y2="15"/>
        </svg>
        <span class="cred-text">Docente invitada<br><strong>Universidad de Buenos Aires</strong></span>
      </div>
      <div class="cred-divider"></div>
      <div class="cred-item">
        <svg class="cred-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
        </svg>
        <span class="cred-text">Reconocida en<br><strong>revistas especializadas</strong> de tejido</span>
      </div>
      <div class="cred-divider"></div>
      <div class="cred-item">
        <svg class="cred-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22c5.5 0 8-2.5 8-8S14 3 12 3 4 6.5 4 14s2.5 8 8 8z"/>
          <path d="M12 8v8M8 12h8"/>
        </svg>
        <span class="cred-text">Artesanía sin<br><strong>producción en serie</strong></span>
      </div>
    </div>
  </section>

  <!-- ─── ARTESANÍAS TEASER ───────────────────────────── -->
  <section class="arte-teaser reveal">
    <div class="arte-teaser-inner">

      <div class="arte-teaser-text">
        <span class="section-tag">También hacemos</span>
        <h2 class="arte-teaser-title">Arte&shy;sanías</h2>
        <p class="arte-teaser-desc">
          Más allá de las gorras: bolsos, muñecos, accesorios y piezas únicas tejidas a mano.
          Cada creación con la misma dedicación y el mismo amor por el detalle.
        </p>
        <a href="/artesanias" class="arte-teaser-cta">
          Explorar artesanías
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>

      <div class="arte-teaser-grid">
        <a href="/artesanias?cat=Sweaters" class="arte-tile">
          <img src="/artesanias/sweaters/especial1.webp" alt="Sweaters tejidos LaNik" loading="lazy" />
          <div class="arte-tile-overlay"></div>
          <span class="arte-tile-label">Sweaters</span>
        </a>
        <a href="/artesanias?cat=Muñecos" class="arte-tile">
          <img src="/artesanias/munecos/muneco4.webp" alt="Muñecos tejidos LaNik" loading="lazy" />
          <div class="arte-tile-overlay"></div>
          <span class="arte-tile-label">Muñecos</span>
        </a>
        <a href="/artesanias?cat=Ponchos" class="arte-tile">
          <img src="/artesanias/ponchos/poncho5.webp" alt="Ponchos tejidos LaNik" loading="lazy" />
          <div class="arte-tile-overlay"></div>
          <span class="arte-tile-label">Ponchos</span>
        </a>
        <a href="/artesanias?cat=Pinturas" class="arte-tile">
          <img src="/artesanias/pinturas/pintura14.webp" alt="Pinturas textiles LaNik" loading="lazy" />
          <div class="arte-tile-overlay"></div>
          <span class="arte-tile-label">Pinturas</span>
        </a>
      </div>

    </div>
