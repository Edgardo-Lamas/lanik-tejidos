---
export const prerender = true
import { gorras } from '../../data/gorras'
import { artesanias } from '../../data/artesanias'
import { SITE } from '../../data/site'

// ── Stats ──────────────────────────────────────────────────────────
const totalGorras    = gorras.length
const gorrasDisp     = gorras.filter(g => g.badge === 'Disponible').length
const gorrasLimitadas = gorras.filter(g => g.badge === 'Serie Limitada').length
const gorrasAgotadas  = gorras.filter(g => g.badge === 'Agotado').length

const totalArte      = artesanias.length
const arteDisp       = artesanias.filter(a => a.badge === 'Disponible').length
const arteLimitadas  = artesanias.filter(a => a.badge === 'Serie Limitada').length
const arteAgotadas   = artesanias.filter(a => a.badge === 'Agotado').length
const arteEncargo    = artesanias.filter(a => a.badge === 'Encargo').length

const totalPiezas    = totalGorras + totalArte
const totalAgotados  = gorrasAgotadas + arteAgotadas
const totalLimitadas = gorrasLimitadas + arteLimitadas
const totalEncargo   = arteEncargo

// Categorías
const catMap: Record<string, number> = {}
artesanias.forEach(a => { catMap[a.categoria] = (catMap[a.categoria] || 0) + 1 })
const categorias = Object.entries(catMap).sort((a, b) => b[1] - a[1])
const catMax = categorias[0]?.[1] ?? 1

// Alertas de stock (agotado + últimas unidades)
const alertas = [
  ...gorras.filter(g => g.badge === 'Agotado' || g.badge === 'Últimas unidades').map(g => ({ nombre: g.nombre, badge: g.badge, tipo: 'Gorra' })),
  ...artesanias.filter(a => a.badge === 'Agotado' || a.badge === 'Últimas unidades').map(a => ({ nombre: a.nombre, badge: a.badge, tipo: a.categoria })),
]

// Todos los productos (tabla catálogo)
const todosCatalogo = [
  ...gorras.map(g => ({ nombre: g.nombre, categoria: 'Gorra', precio: g.precio, badge: g.badge, disponible: g.disponible, wa: `https://wa.me/${SITE.wa}?text=${encodeURIComponent(g.waMessage)}` })),
  ...artesanias.map(a => ({ nombre: a.nombre, categoria: a.categoria, precio: a.precio, badge: a.badge, disponible: a.disponible, wa: `https://wa.me/${SITE.wa}?text=${encodeURIComponent(a.waMessage)}` })),
]

const PIN = import.meta.env.DASHBOARD_PIN ?? '1408'
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard · LaNik</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0 }
    .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0 }
    body { background: #111113; color: #F9FAFB; font-family: 'Inter', sans-serif; min-height: 100vh }
    a { text-decoration: none }
    button { font-family: inherit; cursor: pointer }
    @keyframes spin { from { transform: rotate(0deg) } to { transform: rotate(360deg) } }
    @keyframes blink { 0%,100% { opacity:1 } 50% { opacity:0 } }

    /* PIN */
    #pin-screen {
      position: fixed; inset: 0; background: #111113; z-index: 100;
      display: flex; align-items: center; justify-content: center;
    }
    .pin-box { text-align: center; width: 300px }
    .pin-logo { font-family: 'Space Grotesk', sans-serif; font-size: 24px; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 6px }
    .pin-logo span { color: #B5432A }
    .pin-sub { font-size: 12px; color: #4B5563; margin-bottom: 32px }
    .pin-input {
      width: 100%; padding: 12px 16px; background: #1C1C1E;
      border: 1px solid #3C3C3E; border-radius: 6px;
      color: #F9FAFB; font-size: 20px; font-weight: 600;
      text-align: center; letter-spacing: 6px; outline: none; margin-bottom: 12px;
    }
    .pin-input:focus { border-color: #B5432A }
    .pin-btn {
      width: 100%; padding: 12px; background: #B5432A; color: #fff;
      border: none; border-radius: 6px; font-size: 14px; font-weight: 600;
      transition: background 0.2s;
    }
    .pin-btn:hover { background: #D0563A }
    .pin-error { font-size: 12px; color: #EF4444; margin-top: 8px; min-height: 18px }

    /* Layout */
    #app { display: none; min-height: 100vh }
    .container { max-width: 1280px; margin: 0 auto; padding: 24px 20px 60px }

    /* Header */
    .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px }
    .header-left h1 { font-family: 'Space Grotesk', sans-serif; font-size: 16px; font-weight: 600; color: #F9FAFB; margin-bottom: 2px }
    .header-left p { font-size: 12px; color: #4B5563 }
    .header-actions { display: flex; align-items: center; gap: 10px }
    .btn-ghost {
      display: flex; align-items: center; gap: 6px;
      padding: 6px 12px; border-radius: 4px; border: 1px solid #2C2C2E;
      background: transparent; color: #6B7280; font-size: 12px;
      transition: color 0.2s, border-color 0.2s;
    }
    .btn-ghost:hover { color: #D1D5DB; border-color: #3C3C3E }

    /* Tabs */
    .tabs { display: flex; gap: 2px; margin-bottom: 20px; border-bottom: 1px solid #2C2C2E; padding-bottom: 0 }
    .tab-btn {
      padding: 8px 18px; font-size: 13px; font-weight: 500;
      background: transparent; border: none; border-bottom: 2px solid transparent;
      color: #4B5563; margin-bottom: -1px; transition: color 0.2s;
    }
    .tab-btn.active { border-bottom-color: #B5432A; color: #F9FAFB }
    .tab-btn:hover:not(.active) { color: #9CA3AF }
    .tab-content { display: none }
    .tab-content.active { display: flex; flex-direction: column; gap: 14px }

    /* Panel cards */
    .card {
      background: #1C1C1E; border: 1px solid #2C2C2E;
      border-radius: 6px; overflow: hidden;
    }
    .card-header {
      display: flex; justify-content: space-between; align-items: center;
      padding: 11px 16px; border-bottom: 1px solid #2C2C2E;
    }
    .card-title { font-size: 12px; font-weight: 600; color: #D1D5DB; letter-spacing: 0.01em }
    .card-body { padding: 16px }

    /* KPI grid */
    .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px }
    .kpi {
      background: #161618; border: 1px solid #2C2C2E;
      border-radius: 5px; padding: 14px 16px;
    }
    .kpi-label { font-size: 11px; color: #6B7280; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 6px }
    .kpi-value { font-size: 26px; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 2px }
    .kpi-sub { font-size: 11px; color: #374151 }

    /* Two-col grid */
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 12px }
    @media (max-width: 700px) { .two-col { grid-template-columns: 1fr } }

    /* Bar chart (CSS) */
    .bar-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px }
    .bar-label { font-size: 12px; color: #D1D5DB; width: 90px; flex-shrink: 0 }
    .bar-track { flex: 1; height: 6px; background: #1F1F21; border-radius: 3px; overflow: hidden }
    .bar-fill { height: 100%; border-radius: 3px; background: #B5432A; transition: width 0.6s ease }
    .bar-count { font-size: 11px; color: #6B7280; width: 24px; text-align: right }

    /* Alert list */
    .alert-item {
      display: flex; align-items: center; justify-content: space-between;
      padding: 8px 0; border-bottom: 1px solid #1F1F21;
    }
    .alert-item:last-child { border-bottom: none }
    .alert-name { font-size: 12px; color: #D1D5DB }
    .alert-tipo { font-size: 11px; color: #4B5563 }

    /* Badges */
    .badge { padding: 2px 7px; border-radius: 3px; font-size: 11px; font-weight: 600; letter-spacing: 0.02em }
    .badge-disponible { background: #22C55E22; color: #22C55E }
    .badge-limitada { background: #F59E0B22; color: #F59E0B }
    .badge-ultimas { background: #EF444422; color: #EF4444 }
    .badge-agotado { background: #37415122; color: #6B7280 }
    .badge-encargo { background: #8FAF9A22; color: #8FAF9A }

    /* Tabla catálogo */
    .tabla { width: 100%; border-collapse: collapse; font-size: 12px }
    .tabla th { padding: 0 12px 10px 0; color: #4B5563; font-weight: 500; text-align: left; border-bottom: 1px solid #2C2C2E; white-space: nowrap }
    .tabla td { padding: 8px 12px 8px 0; border-bottom: 1px solid #1F1F21; color: #D1D5DB; white-space: nowrap }
    .tabla tr:last-child td { border-bottom: none }
    .tabla td.precio { color: #9CA3AF; font-variant-numeric: tabular-nums }
    .wrap-table { overflow-x: auto }

    /* Agente tab */
    .agente-header {
      background: #1C1C1E; border: 1px solid #2C2C2E; border-radius: 6px;
      padding: 16px 20px; display: flex; align-items: center; justify-content: space-between;
      gap: 16px; flex-wrap: wrap;
    }
    .agente-header h2 { font-size: 13px; font-weight: 600; color: #F9FAFB; margin-bottom: 3px }
    .agente-header p { font-size: 12px; color: #4B5563 }
    .btn-primary {
      display: flex; align-items: center; gap: 8px;
      padding: 10px 20px; border-radius: 4px; border: none;
      background: #B5432A; color: #fff; font-size: 13px; font-weight: 600;
      transition: background 0.2s; white-space: nowrap;
    }
    .btn-primary:hover { background: #D0563A }
    .btn-primary:disabled { background: #2C2C2E; color: #6B7280; cursor: not-allowed }

    /* Chat UI */
    .chat-wrap {
      background: #1C1C1E; border: 1px solid #2C2C2E;
      border-radius: 6px; display: flex; flex-direction: column;
      height: 580px; overflow: hidden;
    }
    .chat-empty {
      flex: 1; display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      padding: 32px 24px; gap: 16px;
    }
    .chat-empty-title { font-size: 13px; color: #4B5563 }
    .chips { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; max-width: 520px }
    .chip {
      padding: 7px 14px; border: 1px solid #2C2C2E; border-radius: 20px;
      background: #161618; color: #9CA3AF; font-size: 12px; font-family: 'Inter', sans-serif;
      cursor: pointer; transition: all 0.2s;
    }
    .chip:hover { border-color: #B5432A; color: #F9FAFB; background: #2C1412 }
    .chat-messages {
      flex: 1; overflow-y: auto; padding: 20px;
      display: flex; flex-direction: column; gap: 16px;
    }
    .chat-messages::-webkit-scrollbar { width: 4px }
    .chat-messages::-webkit-scrollbar-track { background: transparent }
    .chat-messages::-webkit-scrollbar-thumb { background: #2C2C2E; border-radius: 2px }
    .msg { max-width: 82%; display: flex; flex-direction: column; gap: 4px }
    .msg-user { align-self: flex-end; align-items: flex-end }
    .msg-agent { align-self: flex-start; align-items: flex-start }
    .msg-bubble-user {
      background: #B5432A; color: #fff; padding: 10px 14px;
      border-radius: 16px 16px 4px 16px; font-size: 13px; line-height: 1.5;
    }
    .msg-bubble-agent {
      background: #161618; border: 1px solid #2C2C2E; color: #D1D5DB;
      padding: 12px 16px; border-radius: 16px 16px 16px 4px;
      font-size: 13px; line-height: 1.65;
    }
    .msg-bubble-agent .md-h2 { font-size: 13px; font-weight: 700; color: #F9FAFB; margin: 12px 0 5px }
    .msg-bubble-agent .md-h2:first-child { margin-top: 0 }
    .msg-bubble-agent .md-li { color: #9CA3AF; padding-left: 12px; border-left: 2px solid #2C2C2E; margin: 3px 0 }
    .msg-bubble-agent .md-p { color: #D1D5DB; margin: 2px 0 }
    .msg-time { font-size: 10px; color: #374151 }
    .msg-actions { display: flex; align-items: center; gap: 4px }
    .msg-copy {
      font-size: 10px; color: #374151; background: none; border: none;
      cursor: pointer; padding: 2px 6px; border-radius: 3px;
      font-family: 'Inter', sans-serif; transition: color 0.2s;
    }
    .msg-copy:hover { color: #9CA3AF }
    .chat-input-area {
      border-top: 1px solid #2C2C2E; padding: 12px 16px;
      display: flex; gap: 8px; align-items: center;
    }
    .chat-input {
      flex: 1; background: #161618; border: 1px solid #2C2C2E;
      border-radius: 6px; padding: 10px 14px; color: #F9FAFB;
      font-size: 13px; font-family: 'Inter', sans-serif; outline: none;
      transition: border-color 0.2s;
    }
    .chat-input:focus { border-color: #3C3C3E }
    .chat-input::placeholder { color: #374151 }
    .chat-input:disabled { opacity: 0.5 }
    .chat-send {
      padding: 10px 16px; border-radius: 6px; border: none;
      background: #B5432A; color: #fff; font-size: 13px; font-weight: 600;
      cursor: pointer; transition: background 0.2s; white-space: nowrap;
      display: flex; align-items: center; gap: 6px; flex-shrink: 0;
      font-family: 'Inter', sans-serif;
    }
    .chat-send:hover { background: #D0563A }
    .chat-send:disabled { background: #2C2C2E; color: #4B5563; cursor: not-allowed }
    .cursor {
      display: inline-block; width: 7px; height: 13px;
      background: #B5432A; border-radius: 1px;
      animation: blink 0.8s step-end infinite; margin-left: 2px; vertical-align: middle;
    }
    .spin { animation: spin 1s linear infinite }

    /* Ref card */
    .ref-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px }
    .ref-item { display: flex; align-items: flex-start; gap: 10px; padding: 10px 12px; background: #161618; border: 1px solid #2C2C2E; border-radius: 4px }
    .ref-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; margin-top: 4px }
    .ref-label { font-size: 11px; color: #4B5563; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 2px }
    .ref-val { font-size: 13px; font-weight: 700; margin-bottom: 2px }
    .ref-desc { font-size: 11px; color: #374151 }
  </style>
</head>
<body>

<!-- PIN SCREEN -->
<div id="pin-screen">
  <div class="pin-box">
    <div class="pin-logo">La<span>Nik</span></div>
    <p class="pin-sub">Panel de control · Acceso restringido</p>
    <label for="pin-input" class="visually-hidden">Ingresá el PIN de acceso</label>
    <input id="pin-input" class="pin-input" type="password" maxlength="4" placeholder="••••" autocomplete="off" inputmode="numeric" />
    <button class="pin-btn" id="pin-btn">Ingresar</button>
    <p class="pin-error" id="pin-error"></p>
  </div>
</div>

<!-- DASHBOARD -->
<div id="app">
  <div class="container">

    <!-- Header -->
    <div class="header">
      <div class="header-left">
        <h1>Panel de control</h1>
        <p>LaNik · Tejidos artesanales · Buenos Aires</p>
      </div>
      <div class="header-actions">
        <a href="/" target="_blank" rel="noopener" class="btn-ghost">Ver sitio ↗</a>
        <a href="https://vercel.com" target="_blank" rel="noopener" class="btn-ghost">Vercel ↗</a>
        <button class="btn-ghost" id="logout-btn">Salir</button>
      </div>
    </div>

    <!-- Tabs -->
    <div class="tabs">
      <button class="tab-btn active" data-tab="panel">Panel</button>
      <button class="tab-btn" data-tab="catalogo">Catálogo</button>
      <button class="tab-btn" data-tab="agente">✦ Agente</button>
    </div>

    <!-- ── PANEL TAB ── -->
    <div id="tab-panel" class="tab-content active">

      <!-- KPIs -->
      <div class="kpi-grid">
        <div class="kpi">
          <p class="kpi-label">Total piezas</p>
          <p class="kpi-value" style="color:#F9FAFB">{totalPiezas}</p>
          <p class="kpi-sub">{totalGorras} gorras · {totalArte} artesanías</p>
        </div>
        <div class="kpi">
          <p class="kpi-label">Disponibles</p>
          <p class="kpi-value" style="color:#22C55E">{gorrasDisp + arteDisp}</p>
          <p class="kpi-sub">Listas para vender</p>
        </div>
        <div class="kpi">
          <p class="kpi-label">Series limitadas</p>
          <p class="kpi-value" style="color:#F59E0B">{totalLimitadas}</p>
          <p class="kpi-sub">Alta prioridad de venta</p>
        </div>
        <div class="kpi">
          <p class="kpi-label">Por encargo</p>
          <p class="kpi-value" style="color:#8FAF9A">{totalEncargo}</p>
          <p class="kpi-sub">Producción bajo pedido</p>
        </div>
        <div class="kpi">
          <p class="kpi-label">Agotados</p>
          <p class="kpi-value" style="color:{totalAgotados > 0 ? '#EF4444' : '#374151'}">{totalAgotados}</p>
          <p class="kpi-sub">{totalAgotados > 0 ? 'Requieren atención' : 'Stock completo'}</p>
        </div>
      </div>

      <!-- Categorías + Alertas -->
      <div class="two-col">
        <div class="card">
          <div class="card-header">
            <span class="card-title">Artesanías por categoría</span>
            <span style="font-size:11px;color:#4B5563">{totalArte} piezas</span>
          </div>
          <div class="card-body">
            {categorias.map(([cat, count]) => (
              <div class="bar-row">
                <span class="bar-label">{cat}</span>
                <div class="bar-track">
                  <div class="bar-fill" style={`width:${Math.round((count / catMax) * 100)}%`}></div>
                </div>
                <span class="bar-count">{count}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <span class="card-title">Alertas de stock</span>
            <span style="font-size:11px;color:#4B5563">{alertas.length} {alertas.length === 1 ? 'ítem' : 'ítems'}</span>
          </div>
          <div class="card-body">
            {alertas.length === 0 ? (
              <p style="font-size:12px;color:#374151;text-align:center;padding:16px 0">Sin alertas · stock completo</p>
            ) : alertas.map(a => (
              <div class="alert-item">
                <div>
                  <p class="alert-name">{a.nombre}</p>
                  <p class="alert-tipo">{a.tipo}</p>
                </div>
                <span class={`badge ${a.badge === 'Agotado' ? 'badge-agotado' : 'badge-ultimas'}`}>{a.badge}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Gorras breakdown -->
      <div class="card">
        <div class="card-header">
          <span class="card-title">Gorras — estado del stock</span>
          <span style="font-size:11px;color:#4B5563">{totalGorras} modelos</span>
        </div>
        <div class="card-body">
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:8px">
            {gorras.map(g => (
              <a href={`/gorras/${g.id}`} target="_blank" style="display:flex;flex-direction:column;gap:4px;padding:10px 12px;background:#161618;border:1px solid #2C2C2E;border-radius:4px;text-decoration:none;transition:border-color 0.2s" onmouseover="this.style.borderColor='#3C3C3E'" onmouseout="this.style.borderColor='#2C2C2E'">
                <span style="font-size:12px;color:#D1D5DB;font-weight:500">{g.nombre}</span>
                <span class={`badge ${g.badge === 'Disponible' ? 'badge-disponible' : g.badge === 'Serie Limitada' ? 'badge-limitada' : g.badge === 'Agotado' ? 'badge-agotado' : 'badge-ultimas'}`} style="align-self:flex-start">{g.badge}</span>
                <span style="font-size:11px;color:#4B5563">${g.precio.toLocaleString('es-AR')}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Referencia operativa -->
      <div class="card">
        <div class="card-header"><span class="card-title">Referencia operativa</span></div>
        <div class="card-body">
          <div class="ref-grid">
            {[
              { color: '#22C55E', label: 'WhatsApp', val: '+54 9 11 3198-6298', desc: 'Alejandro · canal de ventas' },
              { color: '#E1306C', label: 'Instagram', val: '@Laniktejidos', desc: 'Canal principal de marca' },
              { color: '#B5432A', label: 'Email', val: 'laniktejidos@gmail.com', desc: 'Consultas y contacto' },
              { color: '#8FAF9A', label: 'Zona', val: 'Palermo Soho', desc: 'Buenos Aires · entregas' },
            ].map(r => (
              <div class="ref-item">
                <div class="ref-dot" style={`background:${r.color}`}></div>
                <div>
                  <p class="ref-label">{r.label}</p>
                  <p class="ref-val" style={`color:${r.color}`}>{r.val}</p>
                  <p class="ref-desc">{r.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

    </div>

    <!-- ── CATÁLOGO TAB ── -->
    <div id="tab-catalogo" class="tab-content">
      <div class="card">
        <div class="card-header">
          <span class="card-title">Catálogo completo</span>
          <span style="font-size:11px;color:#4B5563">{todosCatalogo.length} productos</span>
        </div>
        <div class="card-body">
          <div class="wrap-table">
            <table class="tabla">
              <thead>
                <tr>
                  <th>Nombre</th>
                  <th>Categoría</th>
                  <th>Precio</th>
                  <th>Estado</th>
                  <th>WA</th>
                </tr>
              </thead>
              <tbody>
                {todosCatalogo.map(p => (
                  <tr>
                    <td style="color:#F9FAFB;font-weight:500">{p.nombre}</td>
                    <td style="color:#6B7280">{p.categoria}</td>
                    <td class="precio">{p.precio ? `$${p.precio.toLocaleString('es-AR')}` : 'Consultar'}</td>
                    <td>
                      <span class={`badge ${
                        p.badge === 'Disponible' ? 'badge-disponible' :
                        p.badge === 'Serie Limitada' ? 'badge-limitada' :
                        p.badge === 'Agotado' ? 'badge-agotado' :
                        p.badge === 'Encargo' ? 'badge-encargo' : 'badge-ultimas'
                      }`}>{p.badge}</span>
                    </td>
                    <td>
                      <a href={p.wa} target="_blank" rel="noopener" style="color:#25D366;font-size:11px;font-weight:600">WhatsApp ↗</a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- ── AGENTE TAB ── -->
    <div id="tab-agente" class="tab-content">

      <div class="agente-header">
        <div>
          <h2>Agente LaNik ✦</h2>
          <p>Especialista en catálogo, marketing y estrategia comercial · Conversación continua</p>
        </div>
        <button id="chat-clear" class="btn-ghost">Limpiar chat</button>
      </div>

      <div class="chat-wrap">
        <!-- Empty state -->
        <div id="chat-empty" class="chat-empty">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#2C2C2E" stroke-width="1.5" style="margin-bottom:4px"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          <p class="chat-empty-title">¿En qué te puedo ayudar?</p>
          <div class="chips">
            <button class="chip" data-msg="Analizá el catálogo completo y decime qué acciones concretas tomar esta semana">📊 Análisis semanal</button>
            <button class="chip" data-msg="Sugerí 5 ideas de contenido para Instagram esta semana, específicas para LaNik">📱 Ideas para Instagram</button>
            <button class="chip" data-msg="¿Cuáles son los productos con mejor potencial de venta en este momento?">🎯 Mejor oportunidad</button>
            <button class="chip" data-msg="Armame una estrategia de precios para las series limitadas y cómo comunicarlas">💰 Series limitadas</button>
            <button class="chip" data-msg="¿Cómo mejorar el SEO del sitio lanik-tejidos.vercel.app para llegar a más clientes?">🔍 SEO</button>
            <button class="chip" data-msg="Qué campañas de temporada conviene planificar para otoño/invierno en Buenos Aires">🍂 Temporada</button>
          </div>
        </div>

        <!-- Messages -->
        <div id="chat-messages" class="chat-messages" style="display:none"></div>

        <!-- Input area -->
        <div class="chat-input-area">
          <input id="chat-input" class="chat-input" type="text" placeholder="Preguntá sobre catálogo, estrategia, marketing, Instagram…" autocomplete="off" />
          <button id="chat-send" class="chat-send">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            Enviar
          </button>
        </div>
      </div>

    </div>

  </div>
</div>

<script define:vars={{ PIN }}>
  const KEY = 'lanik_dash_auth'

  function checkAuth() {
    if (localStorage.getItem(KEY) === 'ok') {
      document.getElementById('pin-screen').style.display = 'none'
      document.getElementById('app').style.display = 'block'
    }
  }

  function checkPin() {
    const val = document.getElementById('pin-input').value
    if (val === PIN) {
      localStorage.setItem(KEY, 'ok')
      document.getElementById('pin-screen').style.display = 'none'
      document.getElementById('app').style.display = 'block'
    } else {
      document.getElementById('pin-error').textContent = 'PIN incorrecto'
      document.getElementById('pin-input').value = ''
      setTimeout(() => { document.getElementById('pin-error').textContent = '' }, 2000)
    }
  }

  function logout() {
    localStorage.removeItem(KEY)
    location.reload()
  }

  document.getElementById('pin-btn').addEventListener('click', checkPin)
  document.getElementById('pin-input').addEventListener('keydown', e => { if (e.key === 'Enter') checkPin() })
  document.getElementById('logout-btn').addEventListener('click', () => { localStorage.removeItem(KEY); location.reload() })

  // Tabs
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'))
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'))
      btn.classList.add('active')
      document.getElementById('tab-' + btn.dataset.tab).classList.add('active')
    })
  })

  // ── Chat Agente ──
  let chatMessages = []
  let chatLoading = false
  let chatAbort = null

  function renderMd(text) {
    const div = document.createElement('div')
    text.split('\n').forEach(line => {
      if (line.startsWith('## ')) {
        const p = document.createElement('p')
        p.className = 'md-h2'
        p.textContent = line.replace(/^##\s+/, '')
        div.appendChild(p)
      } else if (line.startsWith('- ')) {
        const p = document.createElement('p')
        p.className = 'md-li'
        p.textContent = line.replace(/^-\s+/, '')
        div.appendChild(p)
      } else if (line.trim()) {
        const p = document.createElement('p')
        p.className = 'md-p'
        p.textContent = line
        div.appendChild(p)
      }
    })
    return div
  }

  function timeNow() {
    return new Date().toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' })
  }

  function appendUserBubble(text) {
    const msgs = document.getElementById('chat-messages')
    const div = document.createElement('div')
    div.className = 'msg msg-user'
    const bubble = document.createElement('div')
    bubble.className = 'msg-bubble-user'
    bubble.textContent = text
    const time = document.createElement('span')
    time.className = 'msg-time'
    time.textContent = timeNow()
    div.appendChild(bubble)
    div.appendChild(time)
    msgs.appendChild(div)
    msgs.scrollTop = msgs.scrollHeight
  }

  function appendAgentBubble() {
    const msgs = document.getElementById('chat-messages')
    const div = document.createElement('div')
    div.className = 'msg msg-agent'
    const bubble = document.createElement('div')
    bubble.className = 'msg-bubble-agent'
    bubble.innerHTML = '<span class="cursor"></span>'
    const meta = document.createElement('div')
    meta.className = 'msg-actions'
    const time = document.createElement('span')
    time.className = 'msg-time'
    time.textContent = timeNow()
    const copyBtn = document.createElement('button')
    copyBtn.className = 'msg-copy'
    copyBtn.textContent = 'Copiar'
    meta.appendChild(time)
    meta.appendChild(copyBtn)
    div.appendChild(bubble)
    div.appendChild(meta)
    msgs.appendChild(div)
    msgs.scrollTop = msgs.scrollHeight
    return { bubble, copyBtn }
  }

  async function sendMessage(text) {
    text = text.trim()
    if (chatLoading || !text) return
    chatLoading = true

    document.getElementById('chat-empty').style.display = 'none'
    document.getElementById('chat-messages').style.display = 'flex'

    chatMessages.push({ role: 'user', content: text })
    appendUserBubble(text)

    const sendBtn = document.getElementById('chat-send')
    const input = document.getElementById('chat-input')
    sendBtn.disabled = true
    input.disabled = true
    input.value = ''

    const { bubble, copyBtn } = appendAgentBubble()
    let agentText = ''
    chatAbort = new AbortController()

    try {
      const res = await fetch('/api/dashboard/agente', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: chatMessages }),
        signal: chatAbort.signal,
      })

      if (!res.ok) {
        const raw = await res.text()
        let msg = `Error ${res.status}`
        try { msg = JSON.parse(raw).error || msg } catch {}
        bubble.innerHTML = `<p class="md-p" style="color:#EF4444">${msg}</p>`
        chatMessages.pop()
        return
      }

      const reader = res.body.getReader()
      const decoder = new TextDecoder()
      const chatMsgs = document.getElementById('chat-messages')
      while (true) {
        const { done, value } = await reader.read()
        if (done) break
        agentText += decoder.decode(value, { stream: true })
        bubble.innerHTML = ''
        bubble.appendChild(renderMd(agentText))
        const cur = document.createElement('span')
        cur.className = 'cursor'
        bubble.appendChild(cur)
        chatMsgs.scrollTop = chatMsgs.scrollHeight
      }

      bubble.innerHTML = ''
      bubble.appendChild(renderMd(agentText))
      chatMessages.push({ role: 'assistant', content: agentText })

      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(agentText)
        copyBtn.textContent = '✓ Copiado'
        setTimeout(() => { copyBtn.textContent = 'Copiar' }, 2000)
      })

    } catch (err) {
      if (err.name !== 'AbortError') {
        bubble.innerHTML = '<p class="md-p" style="color:#EF4444">Error de conexión. Intentá de nuevo.</p>'
        chatMessages.pop()
      }
    } finally {
      chatLoading = false
      sendBtn.disabled = false
      input.disabled = false
      input.focus()
      document.getElementById('chat-messages').scrollTop = document.getElementById('chat-messages').scrollHeight
    }
  }

  document.getElementById('chat-send').addEventListener('click', () => {
    sendMessage(document.getElementById('chat-input').value)
  })

  document.getElementById('chat-input').addEventListener('keydown', e => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(e.target.value) }
  })

  document.getElementById('chat-clear').addEventListener('click', () => {
    chatMessages = []
    chatLoading = false
    chatAbort?.abort()
    document.getElementById('chat-messages').innerHTML = ''
    document.getElementById('chat-messages').style.display = 'none'
    document.getElementById('chat-empty').style.display = 'flex'
  })

  document.querySelectorAll('.chip').forEach(chip => {
    chip.addEventListener('click', () => sendMessage(chip.dataset.msg))
  })

  checkAuth()
</script>

</body>
</html>
