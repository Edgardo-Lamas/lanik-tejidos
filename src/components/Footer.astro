---
import { SITE } from '../data/site'
---
<footer>
  <div class="footer-inner">

    <!-- Marca -->
    <div class="footer-brand">
      <a href="/" class="footer-logo">La<span>Nik</span></a>
      <p>Diseño & Tejido Artesanal<br>Buenos Aires, Argentina</p>
      <!-- Redes sociales -->
      <div class="footer-socials">
        <a href={`https://instagram.com/${SITE.instagram}`} target="_blank" rel="noopener" aria-label="Instagram de LaNik" data-track="click_instagram" class="social-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="4.5"/>
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
          </svg>
        </a>
        <a href={`https://wa.me/${SITE.wa}?text=${encodeURIComponent(SITE.waDefault)}`} target="_blank" rel="noopener" aria-label="WhatsApp de LaNik" data-track="click_whatsapp" class="social-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
        </a>
        <a href={`mailto:${SITE.email}`} aria-label="Email de LaNik" class="social-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <polyline points="2,4 12,13 22,4"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Navegación -->
    <div class="footer-links">
      <span class="footer-col-title">Navegación</span>
      <a href="/gorras">Gorras</a>
      <a href="/artesanias">Artesanías</a>
      <a href="/sobre-lanik">Sobre LaNik</a>
      <a href={`https://wa.me/${SITE.wa}?text=${encodeURIComponent(SITE.waDefault)}`} target="_blank" rel="noopener">Contacto</a>
    </div>

    <!-- Contacto -->
    <div class="footer-contact">
      <span class="footer-col-title">Contacto</span>
      <a href={`https://wa.me/${SITE.wa}`} target="_blank" rel="noopener" data-track="click_whatsapp">
        +54 9 11 3198 6298
      </a>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <span class="footer-location">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        Palermo Soho, Buenos Aires
      </span>
    </div>

  </div>
  <div class="footer-bottom">
    <span>© 2026 LaNik. Todos los derechos reservados.</span>
    <span>Diseño & Tejido Artesanal — Buenos Aires</span>
  </div>
</footer>

<style>
footer {
  background: var(--charcoal);
  border-top: 1px solid rgba(255,255,255,0.07);
  padding: 64px 5% 32px;
}
.footer-inner {
  max-width: 1200px;
  margin: 0 auto 48px;
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr;
  gap: 48px;
  align-items: start;
}
.footer-logo {
  font-family: var(--font-head);
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--white);
  text-decoration: none;
  display: block;
  margin-bottom: 10px;
}
.footer-logo span { color: var(--terracota); }
.footer-brand p {
  font-size: 0.82rem;
  color: rgba(255,255,255,0.38);
  line-height: 1.7;
  margin-bottom: 24px;
}

/* Iconos sociales */
.footer-socials {
  display: flex;
  gap: 10px;
  align-items: center;
}
.social-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.55);
  text-decoration: none;
  transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s;
}
.social-btn svg { width: 17px; height: 17px; }
.social-btn:hover {
  background: rgba(181,67,42,0.18);
  border-color: rgba(181,67,42,0.45);
  color: var(--white);
  transform: translateY(-2px);
}
.social-btn--soon {
  opacity: 0.3;
  cursor: default;
  pointer-events: none;
}

/* Columnas */
.footer-col-title {
  font-family: var(--font-head);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.25);
  display: block;
  margin-bottom: 18px;
}
.footer-links, .footer-contact {
  display: flex;
  flex-direction: column;
  gap: 11px;
}
.footer-links a, .footer-contact a {
  font-family: var(--font-head);
  font-size: 0.85rem;
  color: rgba(255,255,255,0.48);
  text-decoration: none;
  transition: color 0.2s;
}
.footer-links a:hover, .footer-contact a:hover { color: var(--white); }
.footer-location {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.78rem;
  color: rgba(255,255,255,0.28);
  margin-top: 4px;
}
.footer-location svg { flex-shrink: 0; opacity: 0.6; }

/* Bottom */
.footer-bottom {
  max-width: 1200px;
  margin: 0 auto;
  padding-top: 24px;
  border-top: 1px solid rgba(255,255,255,0.06);
  font-size: 0.75rem;
  color: rgba(255,255,255,0.2);
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8px;
}

@media (max-width: 900px) {
  .footer-inner { grid-template-columns: 1fr 1fr; }
  .footer-brand { grid-column: 1 / -1; }
}
@media (max-width: 600px) {
  .footer-inner { grid-template-columns: 1fr; gap: 32px; }
  .footer-brand { grid-column: auto; }
  .footer-bottom { flex-direction: column; gap: 4px; }
}
</style>
